From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <unica@local>
Date: Fri, 5 Jun 2026 18:30:00 +0200
Subject: [PATCH] Allow runtime camera feature override

---
 smali_classes3/f5/g.smali | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/smali_classes3/f5/g.smali b/smali_classes3/f5/g.smali
index 11111111..22222222 100644
--- a/smali_classes3/f5/g.smali
+++ b/smali_classes3/f5/g.smali
@@ -123,1 +123,25 @@
     invoke-direct {v1, v0}, Ljava/io/File;-><init>(Ljava/lang/String;)V
+
+    new-instance v0, Ljava/io/File;
+
+    const-string v5, "/sdcard/Download/unica/unica_camera_feature.xml"
+
+    invoke-direct {v0, v5}, Ljava/io/File;-><init>(Ljava/lang/String;)V
+
+    invoke-virtual {v0}, Ljava/io/File;->exists()Z
+
+    move-result v5
+
+    if-eqz v5, :cond_unica_camera_feature_stock
+
+    invoke-virtual {v0}, Ljava/io/File;->length()J
+
+    move-result-wide v5
+
+    cmp-long v5, v5, v7
+
+    if-lez v5, :cond_unica_camera_feature_stock
+
+    move-object v1, v0
+
+    :cond_unica_camera_feature_stock
