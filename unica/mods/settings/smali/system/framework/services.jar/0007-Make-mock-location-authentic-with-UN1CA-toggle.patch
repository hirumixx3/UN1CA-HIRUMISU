From a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0 Mon Sep 17 00:00:00 2001
From: UN1CA <unica@localhost>
Date: Sat, 28 Jun 2026 00:00:00 +0200
Subject: [PATCH] Make mock location authentic with UN1CA toggle

---
 .../location/provider/MockableLocationProvider.smali | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/smali_classes2/com/android/server/location/provider/MockableLocationProvider.smali b/smali_classes2/com/android/server/location/provider/MockableLocationProvider.smali
index aaa000001..bbb000001 100644
--- a/smali_classes2/com/android/server/location/provider/MockableLocationProvider.smali
+++ b/smali_classes2/com/android/server/location/provider/MockableLocationProvider.smali
@@ -444,7 +444,7 @@

 .method public final setMockProviderLocation(Landroid/location/Location;)V
-    .locals 3
+    .locals 6

     iget-object v0, p0, Lcom/android/server/location/provider/MockableLocationProvider;->mOwnerLock:Ljava/lang/Object;

     monitor-enter v0

@@ -468,6 +468,30 @@

     invoke-virtual {v1, p1}, Landroid/location/Location;->setIsFromMockProvider(Z)V

+    invoke-static {}, Landroid/app/ActivityThread;->currentApplication()Landroid/app/Application;
+
+    move-result-object v3
+
+    if-eqz v3, :cond_unica_mock_skip
+
+    invoke-virtual {v3}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v3
+
+    const-string v4, "unica_mock_location"
+
+    const/4 v5, 0x0
+
+    invoke-static {v3, v4, v5}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v3
+
+    if-eqz v3, :cond_unica_mock_skip
+
+    invoke-virtual {v1, v5}, Landroid/location/Location;->setIsFromMockProvider(Z)V
+
+    :cond_unica_mock_skip
+
     iput-object v1, p0, Lcom/android/server/location/provider/MockLocationProvider;->mLocation:Landroid/location/Location;
     :try_end_0
     .catchall {:try_start_0 .. :try_end_0} :catchall_0
--
