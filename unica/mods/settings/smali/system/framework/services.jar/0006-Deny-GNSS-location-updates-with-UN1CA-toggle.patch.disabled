From 8b68f96fc8a831b7fd1d5eeb7858df1cbd44ef90 Mon Sep 17 00:00:00 2001
From: UN1CA <unica@localhost>
Date: Wed, 24 Jun 2026 00:00:00 +0200
Subject: [PATCH] Deny GNSS location updates with UN1CA toggle

---
 .../gnss/GnssLocationProvider$$ExternalSyntheticLambda6.smali   | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/smali/com/android/server/location/gnss/GnssLocationProvider$$ExternalSyntheticLambda6.smali b/smali/com/android/server/location/gnss/GnssLocationProvider$$ExternalSyntheticLambda6.smali
index 4f01eb642..b90380e45 100644
--- a/smali/com/android/server/location/gnss/GnssLocationProvider$$ExternalSyntheticLambda6.smali
+++ b/smali/com/android/server/location/gnss/GnssLocationProvider$$ExternalSyntheticLambda6.smali
@@ -24,6 +24,26 @@

     iget-object p0, p0, Lcom/android/server/location/gnss/GnssLocationProvider$$ExternalSyntheticLambda6;->f$2:Landroid/location/Location;

+    iget-object v2, v0, Lcom/android/server/location/gnss/GnssLocationProvider;->mContext:Landroid/content/Context;
+
+    invoke-virtual {v2}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v2
+
+    const-string v3, "unica_mock_location"
+
+    const/4 v4, 0x0
+
+    invoke-static {v2, v3, v4}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v2
+
+    if-eqz v2, :cond_unica_gnss_allowed
+
+    return-void
+
+    :cond_unica_gnss_allowed
+
     sget-object v2, Lcom/android/server/location/gnss/GnssLocationProvider;->PROPERTIES:Landroid/location/provider/ProviderProperties;

     const-string v2, "GnssLocationProvider"
--
2.43.0
