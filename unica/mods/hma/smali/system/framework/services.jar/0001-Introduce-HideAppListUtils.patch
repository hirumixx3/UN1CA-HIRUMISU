From: UN1CA Android 17 adaptation <local@unica>
Date: Mon, 27 Jul 2026 00:00:00 -0300
Subject: [PATCH] Introduce HideAppListUtils

Android 17 residual patch.

ComputerEngine já é aplicado pelo helper semântico existente.
Este patch contém somente a parte restante de AppsFilterBase.

---
--- a/smali_classes2/com/android/server/pm/AppsFilterBase.smali
+++ b/smali_classes2/com/android/server/pm/AppsFilterBase.smali
@@ -887,14 +887,47 @@
 
     move-result p0
 
     return p0
 .end method
 
+.method public static shouldFilterApplicationCustom(Lcom/android/server/pm/snapshot/PackageDataSnapshot;ILcom/android/server/pm/pkg/PackageStateInternal;I)Z
+    .locals 2
+
+    const/4 v0, 0x0
+
+    instance-of v1, p0, Lcom/android/server/pm/ComputerEngine;
+
+    if-eqz v1, :cond_0
+
+    check-cast p0, Lcom/android/server/pm/ComputerEngine;
+
+    invoke-virtual {p0, p2, p1, p3}, Lcom/android/server/pm/ComputerEngine;->shouldFilterApplicationCustom(Lcom/android/server/pm/pkg/PackageStateInternal;II)Z
+
+    move-result p0
+
+    return p0
+
+    :cond_0
+    return v0
+.end method
+
 .method public final shouldFilterApplication(Lcom/android/server/pm/snapshot/PackageDataSnapshot;ILjava/lang/Object;Lcom/android/server/pm/pkg/PackageStateInternal;I)Z
     .locals 10
+
+    invoke-static {p1, p2, p4, p5}, Lcom/android/server/pm/AppsFilterBase;->shouldFilterApplicationCustom(Lcom/android/server/pm/snapshot/PackageDataSnapshot;ILcom/android/server/pm/pkg/PackageStateInternal;I)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_hma_apps_filter_continue
+
+    const/4 v0, 0x1
+
+    return v0
+
+    :cond_hma_apps_filter_continue
 
     invoke-static {p2}, Landroid/os/UserHandle;->getAppId(I)I
 
     move-result v0
 
     const/16 v1, 0x2710
