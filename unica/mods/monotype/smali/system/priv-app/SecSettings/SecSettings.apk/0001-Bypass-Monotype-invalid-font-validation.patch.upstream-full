+++ b/smali_classes5/com/samsung/android/settings/display/SecDisplayUtils.smali
@@ -5072,6 +5072,10 @@
 .method public static isInvalidFont(Landroid/content/Context;Ljava/lang/String;)Z
     .locals 10

+    const/4 v0, 0x0
+
+    return v0
+
     new-instance v0, Ljava/lang/StringBuilder;

     const-string v1, "Check if it\'s invalid :"
